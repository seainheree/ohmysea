# .env.example — SALIN jadi .env, lalu isi nilai asli. File ini TIDAK memuat nilai asli.
# Nilai asli hanya boleh ada di .env (gitignored). Jangan pernah commit kunci.

# --- Database (Supabase Postgres, pooler transaksi) ---
# Ganti <ISI_PASSWORD> dengan password database. Port 6543 = transaction pooler (dipakai aplikasi).
DATABASE_URL="postgresql://postgres.<project-ref>:<ISI_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Port 5432 = session/direct. Dipakai drizzle-kit untuk migrate (butuh koneksi non-pooler).
DIRECT_URL="postgresql://postgres.<project-ref>:<ISI_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase (URL & kunci publik boleh tampil di client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Rahasia: hanya server. Dipakai untuk upload gambar ke Storage.
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY_DISINI

# --- LLM chat & curhat (Groq) ---
GROQ_API_KEY=<ISI_GROQ_API_KEY>
# Model tersedia di akun ini: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
# llama-3.3-70b-versatile TIDAK tersedia di akun ini (model_not_found).
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_MODEL_CURHAT=qwen/qwen3.8-27b

# --- Cloudflare Workers AI (embedding + generate gambar) ---
CLOUDFLARE_ACCOUNT_ID=<ISI_CLOUDFLARE_ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<ISI_CLOUDFLARE_API_TOKEN>
CF_MODEL_EMBED=@cf/baai/bge-m3
CF_MODEL_IMAGE=@cf/black-forest-labs/flux-2-klein-4b

# --- Firecrawl (ingest dokumen dari URL) ---
FIRECRAWL_API_KEY=<ISI_FIRECRAWL_API_KEY>

# --- Gerbang akses v1 (satu kode, tanpa akun pengguna) ---
APP_ACCESS_CODE=ISI_KODE_AKSES_DISINI
